# INCIDENTZERO ENVIRONMENT CONFIGURATION
#
# Template only. Nothing in this repository loads a ".env" file for the backend: export these
# variables in the shell that starts uvicorn (or set them in your process manager / container).
# docker compose reads a root-level ".env" file only to substitute ${VITE_API_URL}/${VITE_WS_URL}
# in docker-compose.yml, and Vite reads "frontend/.env*" files for VITE_* variables at build time.
# Every value below is a default or a placeholder; none of it is a real secret.

# --- Backend: read by backend/app/core/config.py and backend/app/core/database.py ---------------
# SQLAlchemy URL of the simulation database (migrations run automatically on boot).
DATABASE_URL=sqlite:///./incidentzero.db
# Docker: docker-compose.yml overrides it with sqlite:////app/data/incidentzero.db (named volume, survives
# container recreation). Optional AUDITS_DIR overrides where post-mortem reports/interviews are written
# (defaults to <repo>/audits, or /app/audits in the container).

# --- Backend: declared in Settings but not consumed by any code path today ------------------------
# The listening port is set on the uvicorn command line (see Makefile, start.sh, backend/Dockerfile),
# not by this variable; ENVIRONMENT is read into Settings but nothing branches on it yet.
PORT=8000
ENVIRONMENT=development

# --- Optional: AI Auditor post-mortem interview ---------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint (full URL, e.g. https://<host>/v1/chat/completions).
# The feature is OFF while LLM_API_KEY is empty: POST /api/audits/postmortem/{id}/interview then answers
# 503 "AI Auditor interview service is not configured". The key is sent as a Bearer token with each turn;
# the rest of the game works without it. With a key but an empty or unreachable base URL each turn
# degrades to a neutral "could not be parsed" PENDING reply (no verdict, no money moves). A key set here is metered by every client that can reach the
# API (no authentication; only a 10 calls / 60 s per-IP limiter), so leave it empty on shared hosts.
# LLM_API_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL_ID=claude-sonnet-5

# --- Frontend (Vite, build time) ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# --- Unused (kept only so existing copies of this file stay recognisable) --------------------------
# SESSION_SECRET: no code in backend/ or frontend/ reads it (there are no sessions or signed cookies;
# the app has no authentication layer). FRONTEND_PORT: only start.sh's second positional argument and
# a constant in frontend/playwright.config.ts decide the dev-server port; this variable is ignored.
SESSION_SECRET=incidentzero-secret-key-entropy
FRONTEND_PORT=5173
